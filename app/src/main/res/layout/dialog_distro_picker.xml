<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/install_title"
        style="@style/DialogTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/install_subtitle"
        style="@style/DialogBody" />

    <Spinner
        android:id="@+id/distro_spinner"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/spinner_bg"
        android:popupBackground="@color/surface2"
        android:paddingHorizontal="14dp" />

    <Button
        android:id="@+id/install_button"
        android:layout_marginTop="20dp"
        android:text="@string/install_btn"
        style="@style/InstallButton" />
</LinearLayout>
